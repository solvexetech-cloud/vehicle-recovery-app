# Vehicle Recovery App - Environment Configuration
# Copy this file to .env and customize as needed.
# NEVER commit .env to git.

# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Database
DB_PATH=./data/app.db

# Uploads (driver documents)
UPLOADS_DIR=./data/uploads

# Dispatch tuning
DISPATCH_OFFER_TIMEOUT_MS=20000
DISPATCH_RADIUS_ROUNDS_KM=5,10,30
DISPATCH_MAX_OFFERS_PER_ROUND=10

# Trip operations
TRIP_ARRIVAL_GPS_THRESHOLD_M=200
TRIP_ALLOW_MANUAL_ARRIVAL_FALLBACK=true

# MFA (super admin only)
MFA_REQUIRED_FOR_SUPER_ADMIN=false

# Optional: custom dev super admin password
# If unset, defaults to 'ChangeMe-Admin-2026!' (logged once at startup in dev only)
# SEED_SUPER_ADMIN_PASSWORD=

# Production
# Never set NODE_ENV=production without:
#   - HTTPS reverse proxy
#   - Verified backups
#   - MFA_REQUIRED_FOR_SUPER_ADMIN=true
#   - SEED_SUPER_ADMIN_PASSWORD unset (create admin manually)